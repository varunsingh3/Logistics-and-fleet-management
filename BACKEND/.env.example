# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/logifleet?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/logifleet
MONGODB_URI=mongodb://127.0.0.1:27017/logifleet

# JWT Secret & Expiration
JWT_SECRET=logifleet_super_secret_jwt_key_2026_replace_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (use * for all or specific origin like http://localhost:5500)
CORS_ORIGIN=*
